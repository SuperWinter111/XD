@startuml C4_L3_Component_01_ExtInterface
!include <C4/C4_Component>

title 外部接口管理分系统 - C4 Level 3 组件图
caption 外部交互层 / 外部接口管理分系统

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

' ============================================================
' 外部系统
' ============================================================

System_Ext(superiorCmd, "上级指控系统", "作战指令下达与态势上报")
System_Ext(khSystem, "KH协同系统", "横向态势共享")
System_Ext(kdSystem, "KD协同系统", "横向态势共享")
System_Ext(planSystem, "筹划系统", "筹划数据输入")
System_Ext(analysisSystem, "数据分析系统", "战后数据分析")

' ============================================================
' 内部依赖容器
' ============================================================

Container(msgBus, "数据交换与消息服务分系统", "消息中间件", "消息总线、数据分发")
Container(monitorLog, "监控与日志分系统", "监控服务", "接口运行监控")

' ============================================================
' 外部接口管理分系统边界
' ============================================================

Container_Boundary(extInterface, "外部接口管理分系统") {

    Component(superiorIF, "上级接口模块", "接口适配器", "上级指令接收与解析\n态势信息上报\n任务状态上报\n请示与审批交互\n上级接口协议适配")

    Component(lateralIF, "横向协同接口模块", "接口适配器", "KH/KD协同数据交换\n协同态势共享\n协同任务协调\n横向接口协议适配")

    Component(fbIF, "前后系统接口模块", "接口适配器", "筹划系统数据对接\n数据分析系统数据输出\n前后系统协议适配")

    Component(protocolMgmt, "接口协议管理模块", "协议管理", "消息格式定义与管理\n协议版本管理\n接口契约管理\n接口文档管理")

    Component(ifMonitor, "接口监控模块", "监控组件", "接口调用状态监控\n接口异常告警\n接口熔断与降级\n接口流量统计")
}

' ============================================================
' 外部关系
' ============================================================

Rel_U(superiorIF, superiorCmd, "指令接收/态势上报", "军用数据链")
Rel_L(lateralIF, khSystem, "态势共享/任务协调", "协同数据链")
Rel_R(lateralIF, kdSystem, "态势共享/任务协调", "协同数据链")
Rel_L(fbIF, planSystem, "接收筹划数据", "数据接口")
Rel_R(fbIF, analysisSystem, "输出作战数据", "数据接口")

' ============================================================
' 内部关系
' ============================================================

Rel_D(superiorIF, protocolMgmt, "使用协议定义")
Rel_D(lateralIF, protocolMgmt, "使用协议定义")
Rel_D(fbIF, protocolMgmt, "使用协议定义")

Rel_R(ifMonitor, superiorIF, "监控接口状态")
Rel_R(ifMonitor, lateralIF, "监控接口状态")
Rel_R(ifMonitor, fbIF, "监控接口状态")

' ============================================================
' 对内部系统的关系
' ============================================================

Rel_D(superiorIF, msgBus, "转发指令/上报态势", "内部消息")
Rel_D(lateralIF, msgBus, "转发协同数据", "内部消息")
Rel_D(fbIF, msgBus, "转发筹划/分析数据", "内部消息")
Rel_D(ifMonitor, monitorLog, "上报监控数据", "内部接口")

@enduml
