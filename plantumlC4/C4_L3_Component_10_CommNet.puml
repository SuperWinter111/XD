@startuml C4_L3_Component_10_CommNet
!include <C4/C4_Component>

title 通信组网分系统 - C4 Level 3 组件图
caption 通信与接入层 / 通信组网分系统

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

' ============================================================
' 外部依赖
' ============================================================

System_Ext(uavSystem, "无人平台任务系统", "通信链路承载")
Container(enhanceUnit, "协同增强单元分系统", "边缘代理", "通过通信链路通信")
Container(extInterface, "外部接口管理分系统", "接口服务", "外部通信承载")
Container(msgBus, "数据交换与消息服务分系统", "消息中间件", "转发通信数据")
Container(monitorLog, "监控与日志分系统", "监控服务", "通信监控数据")

' ============================================================
' 通信组网分系统边界
' ============================================================

Container_Boundary(commNet, "通信组网分系统") {

    Component(linkMgmt, "通信链路管理模块", "链路管理", "链路建立与维护\n链路切换\n状态实时监控\n带宽分配与管理\n链路冗余管理")

    Component(netMgmt, "组网管理模块", "组网管理", "网络拓扑管理\n自组网管理\n网络动态重构\n节点接入/退出管理\n网络路由管理")

    Component(protocolMgmt, "通信协议管理模块", "协议管理", "协议适配与转换\n消息路由与转发\n协议版本管理\n消息序列化/反序列化")

    Component(commSecurity, "通信安全模块", "安全组件", "数据加密传输\n通信认证与鉴权\n抗干扰管理\n频谱管理\n通信保密等级管理")

    Component(commQuality, "通信质量监控模块", "质量监控", "通信质量评估\n丢包率与延迟监控\n链路降级告警\n性能统计\n故障定位")
}

' ============================================================
' 外部关系
' ============================================================

Rel_D(linkMgmt, uavSystem, "数据链路承载", "数据链/自组网")
Rel_U(extInterface, protocolMgmt, "外部通信协议适配")
Rel_D(enhanceUnit, linkMgmt, "使用通信链路", "数据链")

' ============================================================
' 内部模块交互
' ============================================================

Rel_R(linkMgmt, netMgmt, "链路状态→拓扑更新")
Rel_D(linkMgmt, protocolMgmt, "链路上→协议适配")
Rel_D(commSecurity, linkMgmt, "加密/认证→链路保护")
Rel_D(commSecurity, protocolMgmt, "加密→协议层安全")
Rel_R(commQuality, linkMgmt, "监控链路质量")
Rel_R(commQuality, netMgmt, "监控网络质量")

' ============================================================
' 对内部系统
' ============================================================

Rel_D(protocolMgmt, msgBus, "转发通信数据", "内部协议")
Rel_D(commQuality, monitorLog, "上报通信监控数据")

@enduml
