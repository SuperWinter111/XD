@startuml C4_L3_Component_12_AuthAudit
!include <C4/C4_Component>

title 用户权限与安全审计分系统 - C4 Level 3 组件图
caption 运维保障层 / 用户权限与安全审计分系统

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

' ============================================================
' 外部依赖
' ============================================================

Person(sysAdmin, "系统管理员", "用户与权限管理")
Container(hmi, "人机交互分系统", "Web前端/GIS引擎", "登录入口与系统管理界面")
Container(resMgmt, "资源管理分系统", "业务服务", "资源权限校验")
ContainerDb(dbMgmt, "数据库管理分系统", "数据库集群", "用户/权限/审计数据")
Container(monitorLog, "监控与日志分系统", "监控服务", "安全事件上报")

' ============================================================
' 用户权限与安全审计分系统边界
' ============================================================

Container_Boundary(authAudit, "用户权限与安全审计分系统") {

    Component(authMgmt, "身份认证管理模块", "认证服务", "用户登录认证\n多因素认证\n会话管理\n令牌管理\n认证策略配置")

    Component(userInfo, "用户信息管理模块", "用户管理", "用户账号管理\n用户角色管理\n组织架构管理\n用户状态管理")

    Component(permMgmt, "用户权限管理模块", "权限服务", "角色权限配置\n功能权限控制\n数据权限控制\n权限继承与传递\n权限变更审批")

    Component(secAudit, "安全审计模块", "审计服务", "用户操作审计\n敏感操作记录\n审计日志查询\n审计报告生成\n安全事件告警\n合规性检查")
}

' ============================================================
' 外部关系
' ============================================================

Rel_D(sysAdmin, hmi, "管理用户与权限")
Rel_D(hmi, userInfo, "用户CRUD操作", "REST API")
Rel_D(hmi, permMgmt, "权限配置操作", "REST API")
Rel_D(hmi, authMgmt, "登录认证请求", "API")
Rel_D(resMgmt, permMgmt, "资源权限校验", "API")

' ============================================================
' 内部模块交互
' ============================================================

Rel_R(authMgmt, userInfo, "查询用户信息验证")
Rel_D(authMgmt, permMgmt, "认证后→加载权限")
Rel_R(authMgmt, secAudit, "记录认证事件")
Rel_R(permMgmt, secAudit, "记录权限变更")
Rel_R(userInfo, secAudit, "记录用户操作")

' ============================================================
' 对外部容器
' ============================================================

Rel_D(userInfo, dbMgmt, "读写用户数据", "SQL")
Rel_D(permMgmt, dbMgmt, "读写权限数据", "SQL")
Rel_D(secAudit, dbMgmt, "写入审计日志", "SQL")
Rel_D(secAudit, monitorLog, "上报安全事件告警")

@enduml
