@startuml C4_L3_Component_11_EnhanceUnit
!include <C4/C4_Component>

title 协同增强单元分系统 - C4 Level 3 组件图
caption 通信与接入层 / 协同增强单元分系统

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

' ============================================================
' 外部依赖
' ============================================================

System_Ext(uavSystem, "无人平台任务系统", "无人平台(UAV/USV等)")
Container(commNet, "通信组网分系统", "通信服务", "通信链路承载")
Container(battleCtrl, "交战管控分系统", "业务服务", "下发交战计划")
Container(resMgmt, "资源管理分系统", "业务服务", "平台注册与状态")
Container(sitMgmt, "态势管理分系统", "业务服务", "接收目标数据")
Container(msgBus, "数据交换与消息服务分系统", "消息中间件", "消息发布/订阅")

' ============================================================
' 协同增强单元分系统边界
' ============================================================

Container_Boundary(enhanceUnit, "协同增强单元分系统") {

    Component(accessAdapter, "接入适配模块", "适配层", "协议适配(TCP/串口/gRPC/视频流)\n数据格式标准化转换\n接入认证与安全校验\n通信链路心跳检测\n链路异常恢复")

    Component(platformAgent, "平台代理模块", "代理层", "遥控指令下发(飞行/吊舱/武器)\n状态采集上报(飞行/传感器/武器)\n飞行安全监控与应急处置\n飞行禁区管理\n平台能力描述与注册")

    Component(capEnhance, "能力增强模块", "AI增强", "目标检测(为不具备能力的平台补充)\n目标识别(为不具备能力的平台补充)\n目标定位与跟踪\n目标信息标准化上报\n视频关键帧/拼接图像处理\n图像增强处理")

    Component(coopTaskExec, "协同任务执行模块", "任务执行", "交战计划接收与解析\n航路处理与转换/管理\n任务应答与确认\n执行进度上报\n授时同步处理\n多平台协同时序控制")

    Component(unitConfig, "单元配置管理模块", "配置管理", "无人平台参数配置\n通信参数配置\n视频推流参数配置\n能力增强参数配置\n配置模板管理\n配置下发与生效")
}

' ============================================================
' 外部关系 (对无人平台)
' ============================================================

Rel_D(accessAdapter, uavSystem, "双向通信", "TCP/串口/gRPC")
Rel_D(accessAdapter, commNet, "使用通信链路", "数据链")

' ============================================================
' 内部模块交互
' ============================================================

Rel_R(accessAdapter, platformAgent, "适配后数据→代理处理")
Rel_D(platformAgent, capEnhance, "原始传感器数据→能力增强")
Rel_D(coopTaskExec, platformAgent, "指令→代理下发")
Rel_R(unitConfig, accessAdapter, "通信配置参数")
Rel_R(unitConfig, platformAgent, "平台配置参数")
Rel_R(unitConfig, capEnhance, "增强配置参数")

' ============================================================
' 对内部系统 (上报)
' ============================================================

Rel_U(platformAgent, resMgmt, "平台注册/状态上报", "API")
Rel_U(capEnhance, sitMgmt, "上报目标数据", "内部消息")
Rel_U(coopTaskExec, battleCtrl, "上报执行状态/应答", "内部消息")
Rel_U(capEnhance, msgBus, "发布目标/图像数据", "Pub/Sub")
Rel_U(platformAgent, msgBus, "发布平台状态", "Pub/Sub")

' ============================================================
' 从内部系统 (接收)
' ============================================================

Rel_D(battleCtrl, coopTaskExec, "下发交战计划/指令", "内部消息")

@enduml
